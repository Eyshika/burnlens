# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Load it into your shell before running burnlens:  set -a; source .env; set +a
#
# Everything here is optional. Local analysis, the dashboard and the hooks need no key.
# A key is only used by `burnlens explain` and the "Explain" button, and only a digest
# (prompts, file names, command heads, sizes) is sent. Never file contents or tool output.

# Any OpenAI-compatible endpoint (OpenRouter, vLLM, a gateway). Falls back to OPENROUTER_API_KEY.
BURNLENS_LLM_API_KEY=<your-api-key>
# OPENROUTER_API_KEY=<your-openrouter-key>

# Anthropic directly: set only ANTHROPIC_API_KEY and leave the three above unset.
# ANTHROPIC_API_KEY=<your-anthropic-key>

# BURNLENS_LLM_BASE_URL=https://openrouter.ai/api/v1
# BURNLENS_LLM_MODEL=<model-id>
# BURNLENS_LLM_FORMAT=openai            # or: anthropic

# Where Burnlens keeps its state (SQLite, captures, hook log). Default: ~/.burnlens
# BURNLENS_STATE_DIR=<path>
# BURNLENS_CONFIG=<path-to-burnlens.toml>
